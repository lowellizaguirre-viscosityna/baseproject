# ─── .env.example ────────────────────────────────────────────────────────────
# The ONLY env file committed to the repo. It is documentation, not configuration:
# every key the project reads appears here, with its type, default, and whether it
# is a secret. A key the code reads but this file omits fails review
# (docs/standards/config.md).
#
#   make setup   copies this to .env.local and fills what it can
#   .env.local   your real values, git-ignored, never committed
#
# Secrets here carry placeholder values that still pass schema validation, so a
# fresh clone boots and the app fails with a clear message rather than a crash.
#
# Annotations:  [required] must be set   [secret] never logged, never bundled
# Precedence:   CLI flags > env vars > .env.local > .env/profile > defaults

# ─── Core ────────────────────────────────────────────────────────────────────
# development | test | staging | production
APP_ENV=development

# Host and port the server binds to.
HOST=127.0.0.1
PORT=3000

# Base URL the UI and CLI use to reach the API. Must be absolute, no trailing slash.
API_BASE_URL=http://localhost:3000

# Public-facing URL, if different (behind a proxy or CDN). Blank = same as API_BASE_URL.
PUBLIC_URL=

# ─── Logging (docs/standards/logging.md) ─────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Where rotating log files are written. Blank = per-OS app-data default, which is
# what you want. Set it only to pin logs somewhere specific.
LOG_DIR=

# json for machines and the support bundle, pretty for a readable local terminal.
LOG_FORMAT=pretty

# Rotation. Size in MB per file, count of files kept, days before deletion.
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=14
LOG_RETENTION_DAYS=14

# Append-only security/audit log. Separate from the application log, never rotated
# away. Blank = <LOG_DIR>/audit.jsonl
AUDIT_LOG_PATH=

# ─── Diagnostics and support (docs/standards/diagnostics.md) ─────────────────
# Address prefilled in the mailto: handoff when a user emails a support bundle.
SUPPORT_EMAIL=support@example.com

# Optional direct upload endpoint for support bundles. Blank = mailto handoff only,
# which is the default: nothing leaves the machine without a human pressing send.
SUPPORT_UPLOAD_URL=

# Days of logs included in a support bundle.
SUPPORT_BUNDLE_LOG_DAYS=7

# ─── Debug mode (docs/standards/debug-mode.md) ───────────────────────────────
# 1 enables the in-UI inspector and per-control annotations by default. The URL
# parameter, keyboard toggle, and hidden gesture work regardless of this value.
DEBUG_UI=0

# ─── Database (docs/standards/data.md) ───────────────────────────────────────
# [required] Full connection string. Replace the placeholder before first run.
# postgres://user:pass@host:5432/dbname  |  sqlite://./data/app.db
DATABASE_URL=postgres://app:CHANGE_ME@localhost:5432/app_dev

# [secret] Set only if your driver takes the password separately from the URL.
DATABASE_PASSWORD=

DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Refuse to start if the schema version is newer than this code expects.
DB_STRICT_VERSION_CHECK=1

# ─── Auth and sessions (docs/standards/security.md) ──────────────────────────
# [required][secret] Signs session tokens. Generate per environment:
#   openssl rand -hex 32
# A placeholder is accepted in development only; production refuses to boot on it.
SESSION_SECRET=dev-only-insecure-placeholder-change-me

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated allowed origins. Blank = same-origin only. Never use * in production.
CORS_ALLOWED_ORIGINS=

# ─── Limits (docs/standards/errors.md) ───────────────────────────────────────
REQUEST_TIMEOUT_MS=15000
UPSTREAM_TIMEOUT_MS=10000
MAX_REQUEST_BODY_MB=5
RATE_LIMIT_PER_MINUTE=120
RETRY_MAX_ATTEMPTS=3

# ─── Feature flags (docs/standards/feature-flags.md) ─────────────────────────
# Comma-separated local overrides: key=true|false. Highest-precedence flag source
# after a debug-mode request override. Blank = use declared defaults.
FEATURE_FLAGS=

# ─── Observability (docs/standards/observability.md) ─────────────────────────
METRICS_ENABLED=1
METRICS_PATH=/metrics

# Blank = tracing off. Set to an OTLP collector URL to enable spans.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=app

# ─── Build and deploy (docs/standards/build-deploy.md) ───────────────────────
# Default target for `make ship`. local | dev | staging | production. Staging and
# production additionally require an explicit human trigger.
DEPLOY_ENV=dev

# Registry for Docker images. Blank = local daemon only, no push.
DOCKER_REGISTRY=

# Where `make ship` writes deployment zips and the build manifest.
ARTIFACT_DIR=./dist

# Where the dev website/static bundle is deployed for verification.
WEB_DEPLOY_PATH=./dist/web

# APP_VERSION and GIT_COMMIT are injected by the build, not set here. If present
# they override the detected values -- useful in CI, wrong on a workstation.
APP_VERSION=
GIT_COMMIT=

# ─── Outbound services ───────────────────────────────────────────────────────
# Each external dependency gets a kill switch so it can be disabled without a
# deploy (docs/standards/feature-flags.md).
EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# [secret]
SMTP_PASSWORD=

# [secret] Example third-party key. Delete this block if the project has no such
# dependency -- an unused key in this file is as misleading as a missing one.
EXAMPLE_API_KEY=
