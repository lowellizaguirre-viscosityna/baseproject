*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svgz      binary
*.pdf       binary
*.zip       binary
*.7z        binary
*.gz        binary
*.tgz       binary
*.bz2       binary
*.xz        binary
*.rar       binary
*.jar       binary
*.war       binary
*.dll       binary
*.exe       binary
*.so        binary
*.dylib     binary
*.pyd       binary
*.pyc       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.mp3       binary
*.mp4       binary
*.mov       binary
*.xlsx      binary
*.xlsm      binary
*.docx      binary
*.pptx      binary
*.bacpac    binary
*.dacpac    binary
*.ispac     binary
*.mdf       binary
*.ldf       binary
*.bak       binary
*.kdbx      binary
*.iso       binary
