# Encoding and whitespace, enforced by the editor.
# Policy: docs/standards/encoding.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_size = off

[*.{ts,tsx,js,jsx,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
# Trailing whitespace is significant in Markdown (two spaces = line break).
trim_trailing_whitespace = false

# Windows-native scripting. See the BOM note in docs/standards/encoding.md:
# .ps1 targeting PowerShell 5.1 with non-ASCII content needs charset = utf-8-bom.
[*.{ps1,psm1,psd1,ps1xml}]
end_of_line = crlf
charset = utf-8

[*.{bat,cmd,reg,vbs}]
end_of_line = crlf

[*.{sh,bash,zsh}]
end_of_line = lf
indent_size = 4

[{Makefile,makefile,*.mk}]
indent_style = tab

[*.{csv,tsv}]
trim_trailing_whitespace = false
insert_final_newline = false
